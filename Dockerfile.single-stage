# Comparison image for Lab 3 question 5; intentionally keeps the full base and uv.
FROM python:3.10-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_PYTHON_DOWNLOADS=0 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY src/ ./src/
ENV PATH="/app/.venv/bin:$PATH" \
    MLFLOW_DEFAULT_PREDICTION_DEVICE=cpu \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
EXPOSE 8000
CMD ["uvicorn", "src.food11.serve:app", "--host", "0.0.0.0", "--port", "8000"]
